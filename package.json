{
  "name": "tg2ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "skills/*"
  ],
  "scripts": {
    "build": "bun run --filter @tg2ai/web-bot build",
    "dev:bot": "bun run --filter @tg2ai/web-bot dev",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --apply ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.7.0"
  }
}
